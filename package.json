{
  "name": "portfolio",
  "private": true,
  "version": "0.1.0",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "deploy": "npm run build && npx gh-pages -d out",
    "docs:check": "node scripts/validate-repository-docs.mjs",
    "test": "node --test scripts/*.test.mjs",
    "verify:static-export": "node scripts/verify-static-export.mjs",
    "typecheck": "tsc --noEmit --incremental false",
    "validate": "npm run docs:check && npm test && npm run lint && npm run typecheck && npm run build"
  },
  "dependencies": {
    "framer-motion": "11.2.10",
    "lucide-react": "0.451.0",
    "next": "^16.3.2",
    "react": "18.2.0",
    "react-dom": "18.2.0",
    "react-hook-form": "7.51.4"
  },
  "devDependencies": {
    "@types/node": "20.11.30",
    "@types/react": "18.2.66",
    "autoprefixer": "10.4.20",
    "eslint": "^9.0.0",
    "eslint-config-next": "^16.3.2",
    "postcss": "8.5.26",
    "tailwindcss": "3.4.7",
    "typescript": "5.5.4"
  }
}
